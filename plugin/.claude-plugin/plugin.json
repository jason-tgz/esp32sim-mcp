{
  "name": "esp32sim",
  "displayName": "ESP32 Simulator",
  "version": "0.2.6",
  "description": "Boot and test the ESP32 firmware your agent builds in a local emulator: real mask ROM and bootloader, UART assertions, buttons, virtual WiFi, display screenshots. No board, no account.",
  "author": {
    "name": "Emanuele Strazzullo",
    "url": "https://github.com/stramanu"
  },
  "homepage": "https://github.com/stramanu/esp32sim-mcp",
  "repository": "https://github.com/stramanu/esp32sim-mcp",
  "documentationUrl": "https://github.com/stramanu/esp32sim-mcp#readme",
  "supportUrl": "https://github.com/stramanu/esp32sim-mcp/issues",
  "privacyPolicyUrl": "https://github.com/stramanu/esp32sim-mcp/blob/main/PRIVACY.md",
  "license": "MIT",
  "keywords": [
    "esp32",
    "esp-idf",
    "embedded",
    "firmware",
    "emulator",
    "testing",
    "iot"
  ],
  "mcpServers": {
    "esp32sim": {
      "command": "npx",
      "args": [
        "-y",
        "esp32sim-mcp@0.2.6",
        "serve"
      ]
    }
  }
}
